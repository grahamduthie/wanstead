server {
    listen 80;
    server_name wagtailcam.gdx.org.uk;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name wagtailcam.gdx.org.uk;

    ssl_certificate /etc/letsencrypt/live/wagtailcam.gdx.org.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wagtailcam.gdx.org.uk/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Log path only — query strings (including auth tokens) are not recorded
    access_log /var/log/nginx/wagtailcam.log no_query;

    root /var/www/camviewer;
    index index.html;

    location = /internal/auth {
        internal;
        proxy_pass http://127.0.0.1:8086/api/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /login.html {
        try_files $uri =404;
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|js|css)$ {
        try_files $uri =404;
        expires 1d;
        add_header Cache-Control "public";
    }

    location / {
        auth_request /internal/auth;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        error_page 401 = /login.html;

        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Rate-limited MJPEG proxy for the Joggler kiosk (token-authenticated)
    location = /api/live {
        limit_req zone=wcam_live burst=2 nodelay;

        proxy_pass http://127.0.0.1:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection '';
        proxy_http_version 1.1;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /stream/ {
        auth_request /internal/auth;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        error_page 401 = /login.html;

        proxy_pass http://127.0.0.1:8080/stream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection '';
        proxy_http_version 1.1;
        chunked_transfer_encoding off;
    }

    location /ws/stream/ {
        auth_request /internal/auth;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        error_page 401 = /login.html;

        proxy_pass http://127.0.0.1:8087/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
